# ============================================================================
# Platform Engineering Accelerator — .editorconfig
# ============================================================================
# https://editorconfig.org

root = true

# Default settings for all files
[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

# YAML files
[*.{yml,yaml}]
indent_size = 2

# JSON files
[*.json]
indent_size = 2

# Terraform files
[*.{tf,tfvars}]
indent_size = 2

# Helm templates
[*.tpl]
indent_size = 2

# Shell scripts
[*.sh]
indent_size = 2

# PowerShell
[*.{ps1,psm1,psd1}]
indent_size = 4

# Python
[*.py]
indent_size = 4

# C#
[*.cs]
indent_size = 4

# Java
[*.java]
indent_size = 4

# Go
[*.go]
indent_style = tab
indent_size = 4

# Markdown
[*.md]
trim_trailing_whitespace = false

# Makefiles
[Makefile]
indent_style = tab

# Dockerfiles
[Dockerfile*]
indent_size = 4

# Rego policies
[*.rego]
indent_size = 2
